{
  "alias": "grantor",
  "description": "grantor example provider",
  "server": {
    "discoveryUrl": "https://host.docker.internal:9443/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-client",
    "client_secret": "conformance-client-secret-0f6b1c2e9a4d4b7e8c3a5d6f7e8a9b0c"
  },
  "client2": {
    "client_id": "conformance-client2",
    "client_secret": "conformance-client2-secret-1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d"
  },
  "client_secret_post": {
    "client_id": "conformance-post",
    "client_secret": "conformance-post-secret-9f8e7d6c5b4a39281706f5e4d3c2b1a0"
  },
  "browser": [
    {
      "match": "https://host.docker.internal:9443/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://host.docker.internal:9443/login*",
          "commands": [
            [
              "text",
              "name",
              "username",
              "alice"
            ],
            [
              "text",
              "name",
              "password",
              "password"
            ],
            [
              "click",
              "xpath",
              "//button[@value='login']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "updates placeholder during the second authorization",
          "match": "https://host.docker.internal:9443/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://host.docker.internal:9443/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "username",
                  "alice"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "password"
                ],
                [
                  "click",
                  "xpath",
                  "//button[@value='login']"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "updates placeholder during the second authorization",
          "match": "https://host.docker.internal:9443/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://host.docker.internal:9443/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "username",
                  "alice"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "password"
                ],
                [
                  "click",
                  "xpath",
                  "//button[@value='login']"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://host.docker.internal:9443/authorize*",
          "tasks": [
            {
              "task": "Expect redirect uri mismatch error page",
              "match": "https://host.docker.internal:9443/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Unable to continue",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://host.docker.internal:9443/authorize*",
          "tasks": [
            {
              "task": "Expect redirect uri mismatch error page",
              "match": "https://host.docker.internal:9443/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Unable to continue",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    }
  }
}
